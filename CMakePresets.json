{
  "version": 3,
  "configurePresets": [
    {
      "name": "arm",
      "displayName": "Firmware (arm-none-eabi, Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-arm",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "native",
      "displayName": "Unit tests (host g++, Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-native",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "arm",
      "configurePreset": "arm"
    },
    {
      "name": "native",
      "configurePreset": "native"
    }
  ],
  "testPresets": [
    {
      "name": "native",
      "configurePreset": "native",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 30
      }
    }
  ]
}
